# ─────────────────────────────────────────────────────────────────────────────
# Dejoiy Desk — Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRESQL_DB=dejoiy_production
POSTGRESQL_USER=dejoiy
# REQUIRED — choose a strong password
POSTGRESQL_PASS=changeme_strong_password
POSTGRESQL_PORT=5432

# ── Application ───────────────────────────────────────────────────────────────
# Your server's domain name or IP (used by nginx & emails sent by the app)
DEJOIY_FQDN=desk.yourdomain.com

# Rails secret (generate with: openssl rand -hex 64)
SECRET_KEY_BASE=changeme_generate_with_openssl_rand_hex_64

# Port to expose on the host (default 80; use 443 with a TLS proxy in front)
HTTP_PORT=80

# ── Elasticsearch (full-text search) ─────────────────────────────────────────
# Set to false to disable (reduces RAM usage, disables full-text search)
ELASTICSEARCH_ENABLED=true

# ── Email (outbound notifications) ───────────────────────────────────────────
# Uncomment and fill in your SMTP settings
# SMTP_DOMAIN=yourdomain.com
# SMTP_ADDRESS=smtp.yourdomain.com
# SMTP_PORT=587
# SMTP_USER=notifications@yourdomain.com
# SMTP_PASSWORD=your_smtp_password

# ── Docker image ──────────────────────────────────────────────────────────────
# Tag used when building/pulling the image
IMAGE_TAG=latest
# Git commit SHA injected into the image version string (auto-set in CI)
COMMIT_SHA=local

# ── Nginx upload limit ────────────────────────────────────────────────────────
NGINX_CLIENT_MAX_BODY_SIZE=50M
