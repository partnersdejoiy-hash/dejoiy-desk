# DEJOIY Internal Tools — private deployment
# Copy to deploy/.env and adjust before: docker compose up -d

# --- Public URL (your portal / internal hostname) ---
# Use http until HTTPS is configured on your reverse proxy (required for setup/login).
ZAMMAD_HTTP_TYPE=http
ZAMMAD_FQDN=desk.dejoiy.internal

# --- Image (build from this repo; do not pull vendor images for production) ---
IMAGE_REPO=dejoiy/desk
VERSION=local
# Set BUILD_LOCAL=true in install script to build from ../Dockerfile

# --- Database (isolated from any old Zammad stack) ---
POSTGRES_DB=dejoiy_production
POSTGRES_USER=dejoiy
POSTGRES_PASS=CHANGE_ME_STRONG_PASSWORD
POSTGRES_HOST=dejoiy-postgresql

# --- Ports (only expose nginx; bind to localhost + reverse proxy if needed) ---
NGINX_EXPOSE_PORT=8080
NGINX_PORT=8080
ZAMMAD_RAILSSERVER_HOST=dejoiy-railsserver
ZAMMAD_WEBSOCKET_HOST=dejoiy-websocket

# --- Outbound email (password reset, signup verify) ---
# Configure SMTP in Admin → Channels → Email → Notification after first login.
# See deploy/EMAIL.md and: ./deploy/scripts/diagnose-email.sh

# --- Privacy: no vendor geo / image / AI phone-home ---
DEJOIY_ENABLE_VENDOR_SERVICES=false
# Optional: your own internal AI gateway only (never vendor defaults)
# DEJOIY_AI_API_URL=https://ai.internal.dejoiy
# DEJOIY_AI_TOKEN=

# --- Search (recommended for teams > ~5 agents) ---
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NAMESPACE=dejoiy

# --- First-install super admin (fresh database only) ---
# Set a strong password, then run: ./deploy/scripts/generate-autowizard.sh
# That writes AUTOWIZARD_JSON into deploy/.env for automated setup on first boot.
DEJOIY_ADMIN_LOGIN=admin
DEJOIY_ADMIN_EMAIL=admin@dejoiy.internal
DEJOIY_ADMIN_PASSWORD=CHANGE_ME_ON_FIRST_LOGIN
DEJOIY_ADMIN_FIRSTNAME=DEJOIY
DEJOIY_ADMIN_LASTNAME=Admin
DEJOIY_ORGANIZATION=DEJOIY
DEJOIY_PRODUCT_NAME=DEJOIY Internal Tools
# AUTOWIZARD_JSON=          # generated by generate-autowizard.sh
AUTOWIZARD_RELATIVE_PATH=tmp/auto_wizard.json

# --- Timezone ---
TZ=UTC

# --- Restart policy ---
RESTART=always
